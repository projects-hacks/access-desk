{
  "name": "@access-desk/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p .",
    "test": "tsx --env-file-if-exists=../.env --test \"src/**/*.test.ts\"",
    "try": "tsx --env-file-if-exists=../.env src/index.ts try",
    "shadow": "tsx --env-file-if-exists=../.env src/shadow.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@factory/droid-sdk": "^0.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "spacetimedb": "2.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15"
  }
}
