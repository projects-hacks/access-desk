# SpacetimeDB (system of work): one shared database on Maincloud
STDB_URI=wss://maincloud.spacetimedb.com
STDB_HTTP_URL=https://maincloud.spacetimedb.com
STDB_DATABASE=access-desk-calhacks13
STDB_AGENT_TOKEN=
# Server identity (role SYNC); only needed where sync runs
STDB_TOKEN=
# Gateway identity (role GATEWAY); only needed where the gateway runs
STDB_GATEWAY_TOKEN=
# Demo controls identity (role DEMO) and switch for /demo/* endpoints
STDB_DEMO_TOKEN=
DEMO_CONTROLS=false

# Server (gateway, sync, simulator)
PORT=4000
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_RUN=dev
# nessie | fake (in-memory bank)
BANK_MODE=nessie

# Agents (Python)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
FACTORY_API_KEY=

# Web (Vite exposes only VITE_* vars)
VITE_STDB_URI=wss://maincloud.spacetimedb.com
VITE_STDB_DATABASE=access-desk-calhacks13
VITE_API_URL=http://localhost:4000
# Console identity for approvals (role CONTROLLER via pnpm stdb:roles). Ask for it; never commit.
VITE_STDB_CONTROLLER_TOKEN=

# Platform identity (rename the platform here)
PLATFORM_NAME="Northstar Prime"
PLATFORM_LEGAL_NAME="Northstar Prime Ltd"
# Simulated "today" for the demo world
SIM_DATE=2026-03-03
