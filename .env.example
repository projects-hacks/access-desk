# Secrets only. Everything else has a default in code (server/src/lib/env.ts, agents/src/env.ts, web/src/lib/config.ts); add a line here only to override.

# API keys
NESSIE_API_KEY=
ANTHROPIC_API_KEY=
FACTORY_API_KEY=
# The agents ask Factory's Droid first (needs the `droid` CLI on PATH), then Claude, then fall back to rules.
# LLM_MODEL=claude-opus-5-5
# LLM_CONCURRENCY=2
# AGENT_MODE=rules        # rules | shadow | droid (Sage and Rowan with tools)

# Server identities (roles SYNC, GATEWAY, DEMO)
STDB_TOKEN=
STDB_GATEWAY_TOKEN=
STDB_DEMO_TOKEN=

# Agents identity (role AGENT)
STDB_AGENT_TOKEN=

# Web console identity (role CONTROLLER, shown as Maya Chen)
VITE_STDB_CONTROLLER_TOKEN=

# The platform living on its own (hosted server only; needs STDB_DEMO_TOKEN). See docs/world.md. Defaults:
# WORLD_EVENTS=true                  off unless set
# WORLD_SECONDS_PER_DAY=240          one sim day per this many real seconds (0 = leave the clock alone)
# WORLD_EVENT_MIN_SECONDS=20         a client event every 20-60 s, jittered
# WORLD_EVENT_MAX_SECONDS=60
# WORLD_CLIENT_DAY_CAP=2             events per client per sim day
# WORLD_BANK_WRITES_PER_MINUTE=20    Nessie writes the world may make
# WORLD_PAUSE_GRACE_SECONDS=300      a paused clock is resumed after this long

# /demo/* endpoints
DEMO_CONTROLS=true
# Hosted API and its demo key (ask for the values)
VITE_API_URL=
DEMO_KEY=
VITE_DEMO_KEY=
