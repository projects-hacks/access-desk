# Secrets only. Everything else has a default in code (server/src/lib/env.ts, agents config.py, web/src/lib/config.ts); add a line here only to override.

# API keys
NESSIE_API_KEY=
ANTHROPIC_API_KEY=
FACTORY_API_KEY=
# LLM provider for the credit and exploit agents (default anthropic). Droid also needs the
# `droid` CLI on PATH. Defaults: Factory decides (claude-opus-5-5), Claude is the backup, then the rules.
# Without droid or a Factory key the Claude API answers instead; LLM_PROVIDER=anthropic forces it.
# LLM_PROVIDER=factory
# LLM_FALLBACK=anthropic
# FACTORY_MODEL=claude-opus-5-5
# FACTORY_TIMEOUT_SECONDS=120

# Server identities (roles SYNC, GATEWAY, DEMO)
STDB_TOKEN=
STDB_GATEWAY_TOKEN=
STDB_DEMO_TOKEN=

# Agents identity (role AGENT)
STDB_AGENT_TOKEN=

# Web console identity (role CONTROLLER)
VITE_STDB_CONTROLLER_TOKEN=
VITE_STDB_CONTROLLER_B_TOKEN=

# /demo/* endpoints
DEMO_CONTROLS=true
# Hosted API and its demo key (ask for the values)
VITE_API_URL=
DEMO_KEY=
VITE_DEMO_KEY=
