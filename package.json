{
  "name": "access-desk",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @access-desk/web dev",
    "dev:server": "SERVER_HOST=true pnpm --filter @access-desk/server dev",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "stdb:publish": "spacetime publish -s maincloud -p spacetime -y access-desk-calhacks13",
    "stdb:generate": "spacetime generate -l typescript -p spacetime -o web/src/module_bindings && spacetime generate -l typescript -p spacetime -o server/src/module_bindings",
    "agents": "cd agents && uv run desk-agents",
    "stdb:publish:reset": "spacetime publish -s maincloud -p spacetime --delete-data -y access-desk-calhacks13",
    "seed:nessie": "pnpm --filter @access-desk/server seed:nessie",
    "bank": "pnpm --filter @access-desk/server bank",
    "test": "pnpm -r test",
    "stdb:sql": "spacetime sql -s maincloud access-desk-calhacks13",
    "stdb:logs": "spacetime logs -s maincloud -f access-desk-calhacks13",
    "sync": "pnpm --filter @access-desk/server sync",
    "sync:verify": "pnpm --filter @access-desk/server sync:verify",
    "stdb:roles": "pnpm --filter @access-desk/server stdb:roles",
    "payments:verify": "pnpm --filter @access-desk/server payments:verify",
    "demo:reset": "pnpm --filter @access-desk/server reset",
    "demo:rebuild": "pnpm bank reset && pnpm stdb:publish:reset && pnpm stdb:roles && pnpm host:restart",
    "host:restart": "az containerapp revision restart -n access-desk-api -g access-desk-rg --revision $(az containerapp show -n access-desk-api -g access-desk-rg --query properties.latestRevisionName -o tsv) -o none",
    "ledger:verify": "pnpm --filter @access-desk/server ledger:verify",
    "tieout:verify": "pnpm --filter @access-desk/server tieout:verify",
    "actions:verify": "pnpm --filter @access-desk/server actions:verify",
    "portal:verify": "pnpm --filter @access-desk/server portal:verify",
    "credit:fixture": "pnpm --filter @access-desk/server credit:fixture",
    "credit:verify": "pnpm --filter @access-desk/server credit:verify"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
