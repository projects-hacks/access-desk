{
  "name": "@access-desk/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p .",
    "seed:nessie": "tsx --env-file-if-exists=../.env src/scripts/seed-nessie.ts",
    "bank": "tsx --env-file-if-exists=../.env src/scripts/bank.ts",
    "test": "tsx --env-file-if-exists=../.env --test \"src/**/*.test.ts\"",
    "stdb:check": "tsx --env-file-if-exists=../.env src/scripts/stdb-check.ts",
    "sync": "tsx --env-file-if-exists=../.env src/scripts/sync-once.ts",
    "sync:verify": "tsx --env-file-if-exists=../.env src/scripts/sync-verify.ts",
    "stdb:roles": "tsx --env-file-if-exists=../.env src/scripts/assign-roles.ts",
    "payments:verify": "tsx --env-file-if-exists=../.env src/scripts/payments-verify.ts",
    "ledger:verify": "tsx --env-file-if-exists=../.env src/scripts/ledger-verify.ts",
    "tieout:verify": "tsx --env-file-if-exists=../.env src/scripts/tieout-verify.ts",
    "actions:verify": "tsx --env-file-if-exists=../.env src/scripts/actions-verify.ts",
    "portal:verify": "tsx --env-file-if-exists=../.env src/scripts/portal-verify.ts",
    "credit:fixture": "tsx --env-file-if-exists=../.env src/scripts/credit-fixture.ts",
    "credit:verify": "tsx --env-file-if-exists=../.env src/scripts/credit-verify.ts",
    "world:plan": "tsx --env-file-if-exists=../.env src/scripts/world-plan.ts",
    "reset": "tsx --env-file-if-exists=../.env src/scripts/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "fastify": "^5.12.7",
    "spacetimedb": "2.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15"
  }
}
